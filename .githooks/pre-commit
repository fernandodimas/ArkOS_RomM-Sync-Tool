#!/bin/bash
# =============================================================================
# pre-commit hook — Auto-bump de versão do RomMSync.sh
#
# Instalação automática:  git config core.hooksPath .githooks
# Instalação manual:      cp .githooks/pre-commit .git/hooks/pre-commit
#                         chmod +x .git/hooks/pre-commit
# =============================================================================

SCRIPT_FILE="RomMSync.sh"

# Só age se RomMSync.sh estiver entre os arquivos staged
if ! git diff --cached --name-only | grep -qF "$SCRIPT_FILE"; then
    exit 0
fi

# Lê versão atual (formato MAJOR.MINOR.PATCH)
current=$(grep -m1 '^readonly VERSION=' "$SCRIPT_FILE" \
          | sed 's/.*VERSION="\([^"]*\)".*/\1/')

if [ -z "$current" ]; then
    echo "[version-hook] AVISO: VERSION não encontrada em $SCRIPT_FILE — pulando bump."
    exit 0
fi

# Separa major.minor.patch
major=$(echo "$current" | cut -d. -f1)
minor=$(echo "$current" | cut -d. -f2)
patch=$(echo "$current" | cut -d. -f3)

# Garante que patch é numérico; começa em 0 se não existir
patch=${patch:-0}
if ! echo "$patch" | grep -qE '^[0-9]+$'; then
    echo "[version-hook] AVISO: patch '$patch' não é numérico — pulando bump."
    exit 0
fi

new_patch=$((patch + 1))
new_version="${major}.${minor}.${new_patch}"

# Substitui VERSION no script
sed -i.bak "s/^readonly VERSION=\"${current}\"/readonly VERSION=\"${new_version}\"/" \
    "$SCRIPT_FILE" && rm -f "${SCRIPT_FILE}.bak"

# Reestadia o arquivo com a nova versão
git add "$SCRIPT_FILE"

echo "[version-hook] Versão atualizada: v${current} → v${new_version}"
